<% content_for :title, "Portal do Estudante" %>
<%= render "nav_estudante" %>

<main class="container py-4">
  <%= render "menus/widget", menu: @widget_menu, weekday_name: @widget_weekday_name %>

  <% if flash[:notice] %>
    <p><%= flash[:notice] %></p>
  <% end %>

  <% if flash[:alert] %>
    <p><%= flash[:alert] %></p>
  <% end %>

  Saldo: <%= number_to_currency(@student.balance_cents / 100.0, unit: "R$ ", separator: ",", delimiter: ".") %>
</main>
