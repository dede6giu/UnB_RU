<% content_for :title, "Autenticação do Estudante" %>
<h1>Autenticação do Estudante</h1>

<% if flash[:notice] %>
  <p><%= flash[:notice] %></p>
<% end %>

<% if flash[:alert] %>
  <p><%= flash[:alert] %></p>
<% end %>

<form action="/student_sessions" method="post">
  <label for="student-user">Usuário:</label>
  <input type="text" id="student-user" name="student[user]"><br><br>
  <label for="student-password">Senha:</label>
  <input type="password" id="student-pass" name="student[password]"><br><br>
  <input type="submit" value="Login">
</form>
