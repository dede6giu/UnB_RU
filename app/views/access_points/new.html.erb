<% content_for :title, "Configuração de Ponto" %>

<% if flash[:notice] %>
  <p><%= flash[:notice] %></p>
<% end %>

<% if flash[:alert] %>
  <p><%= flash[:alert] %></p>
<% end %>

      <%= form_with url: access_point_path do %>
      <div class="mb-4">
        <div class="d-flex justify-content-between">
          <label for="access-point-turnstile" class="form-label fw-medium">Unidade Operacional</label>
          <span class="fs-xs fg-4">Obrigatório</span>
        </div>
        <div class="form-control form-adorn">
          <span class="form-adorn-icon">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16">
              <path d="M8 8a3 3 0 1 0 0-6 3 3 0 0 0 0 6m2-3a2 2 0 1 1-4 0 2 2 0 0 1 4 0m4 8c0 1-1 1-1 1H3s-1 0-1-1 1-4 6-4 6 3 6 4m-1-.004c-.001-.246-.154-.986-.832-1.664C11.516 10.68 10.289 10 8 10s-3.516.68-4.168 1.332c-.678.678-.83 1.418-.832 1.664z"/>
            </svg>
          </span>
          <% @turnstiles.each do |turnstile| %>
            <div class="form-check">
              <input class="form-check-input" type="radio" name="access_point[turnstile_id]" id="turnstile-<%= turnstile.id %>" value="<%= turnstile.id %>">
              <label class="form-check-label" for="turnstile-<%= turnstile.id %>">
                <%= turnstile.name %>
              </label>
            </div>
          <% end %>
          <label for="access-point-turnstile" class="form-label visually-hidden">Selecione a Catraca</label>
        </div>
        <span class="fs-sm fg-3 mb-6">Selecione a Catraca.</span>
        <button type="submit" class="btn-solid theme-primary w-100">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16">
            <path fill-rule="evenodd" d="M6 3.5a.5.5 0 0 1 .5-.5h8a.5.5 0 0 1 .5.5v9a.5.5 0 0 1-.5.5h-8a.5.5 0 0 1-.5-.5v-2a.5.5 0 0 0-1 0v2A1.5 1.5 0 0 0 6.5 14h8a1.5 1.5 0 0 0 1.5-1.5v-9A1.5 1.5 0 0 0 14.5 2h-8A1.5 1.5 0 0 0 5 3.5v2a.5.5 0 0 0 1 0z"/>
            <path fill-rule="evenodd" d="M11.854 8.354a.5.5  0 0 0 0-.708l-3-3a.5.5 0 1 0-.708.708L10.293 7.5H1.5a.5.5 0 0 0 0 1h8.793l-2.147 2.146a.5.5 0 0 0 .708.708z"/>
          </svg>
          Confirmar e Iniciar Operação
        </button>
      <% end %>