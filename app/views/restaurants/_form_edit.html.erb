<div id="form">
  <%= form_with(model: restaurant) do |form| %>
    <% if restaurant.errors.any? %>
      <div class="fg-danger">
        <div class="h2"><%= restaurant.errors.count %> erros impediram a operação:</div>

        <ul>
          <% restaurant.errors.each do |error| %>
            <li><%= error.full_message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <div class="p-4">
      <%= form.label :name, "Nome", style: "display: block", class: "form-label" %>
      <%= form.text_field :name, class: "form-control w-25" %>
    </div>

    <div class="p-4">
      <%= form.label :campus, "Campus", style: "display: block", class: "form-label" %>
      <%= form.text_field :campus, class: "form-control w-25" %>
    </div>

    <div class="p-4 d-flex gap-6">
      <%= form.submit "Atualizar Restaurante", class: "btn-subtle theme-success" %>
      <%= link_to "Remover Unidade", restaurant_path(@restaurant),
                  data: { turbo_method: :delete, turbo_confirm: "Tem certeza?" },
                  class: "btn-subtle theme-danger" %>
    </div>
  <% end %>
  <div class="p-4">
    <%= link_to "Retornar", restaurants_path, class: "btn-subtle" %>
  </div>
</div>
