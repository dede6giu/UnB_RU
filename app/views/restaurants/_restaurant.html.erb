<% @turnstiles = Turnstile.all.where(:restaurant_id => restaurant.id) %>
<div id="<%= dom_id restaurant %>" class="mt-5 bg-white shadow-sm">

  <!-- NOME -->
  <div class="d-flex p-5 gap-5 bg-3">
    <div class="bg-success fg-white ms-4 w-4 fs-3xl text-center fw-semibold rounded-3"><%= restaurant.id %></div>
    <div class="d-flex flex-grow-1 flex-column">
      <div class="h3 fg-success fw-semibold"><%= restaurant.name %> (<%= restaurant.campus %>)</div>
      <div class="fs-sm fg-4 fw-normal">Quantidade de catracas: <%= @turnstiles.count %></div>
    </div>
    <%= button_to "Editar Unidade", edit_restaurant_path(restaurant),
                  class: "btn-outline theme-success h-100",
                  :method => :get%>
    <%= button_to "Cadastrar Catraca", new_turnstile_path,
                  class: "btn-outline theme-success h-100",
                  :method => :get%>
  </div>

  <!-- CATRACAS -->
  <div class="p-4">
    <div class="container-fluid">
      <div class="row row-cols-2 g-3">
        <% @turnstiles.each do |turnstile| %>
          <% if turnstile.operation == "Inativa" %>
            <% color_turnstile = "fg-danger" %>
          <% elsif turnstile.operation == "FastPass" %>
            <% color_turnstile = "fg-accent" %>
          <% else %>
            <% color_turnstile = "fg-success" %>
          <% end %>
          <div class="col d-flex">
            <div class="flex-column bg-2 p-5 flex-grow-1">
              <div class="fw-bold fs-md"><%= turnstile.name %></div>
              <div class="d-flex gap-3 align-items-center">
                <% if turnstile.operation == "Ativa" %>
                  <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-circle <%= color_turnstile %>" viewBox="0 0 16 16">
                    <path d="M8 15A7 7 0 1 1 8 1a7 7 0 0 1 0 14m0 1A8 8 0 1 0 8 0a8 8 0 0 0 0 16"/>
                  </svg>
                <% else %>
                  <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-circle-fill <%= color_turnstile %>" viewBox="0 0 16 16">
                    <circle cx="8" cy="8" r="8"/>
                  </svg>
                <% end %>
                <div class="fs-md <%= color_turnstile %>"><%= turnstile.operation %></div>
              </div>
            </div>
            <div class="bg-2 align-content-center p-5">
              <%= button_to "Editar Catraca", edit_turnstile_path(turnstile),
                            class: "btn-outline theme-primary",
                            :method => :get%>
            </div>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</div>