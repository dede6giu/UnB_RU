<% content_for :title, "Autenticação de Admin" %>
<div data-bs-theme="light" class="bg-1 min-vh-100">
  <%= render "header_login", selo: "ADMINISTRAÇÃO" %>

  <div class="card shadow-sm mx-auto mt-12" style="max-width: 540px;">
    <div class="card-body p-8">
      <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" fill="currentColor" class="fg-primary" viewBox="0 0 16 16">
        <path d="M6.5 2a.5.5 0 0 0 0 1h3a.5.5 0 0 0 0-1zM11 8a3 3 0 1 1-6 0 3 3 0 0 1 6 0"/>
        <path d="M4.5 0A2.5 2.5 0 0 0 2 2.5V14a2 2 0 0 0 2 2h8a2 2 0 0 0 2-2V2.5A2.5 2.5 0 0 0 11.5 0zM3 2.5A1.5 1.5 0 0 1 4.5 1h7A1.5 1.5 0 0 1 13 2.5v10.795a4.2 4.2 0 0 0-.776-.492C11.392 12.387 10.063 12 8 12s-3.392.387-4.224.803a4.2 4.2 0 0 0-.776.492z"/>
      </svg>
      <h1 class="h3 fw-semibold mt-2">Autenticação do Administrador</h1>
      <p class="fs-sm fg-3 mb-6">Entre com sua matrícula funcional para gerenciar restaurantes, catracas e relatórios.</p>

      <%= render "flash" %>

      <%= form_with url: admin_session_path do %>
        <div class="mb-4">
          <div class="d-flex justify-content-between">
            <label for="admin-user" class="form-label fw-medium">Matrícula</label>
            <span class="fs-xs fg-4">Obrigatório</span>
          </div>
          <div class="form-control form-adorn">
            <span class="form-adorn-icon">
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16">
                <path d="M8 8a3 3 0 1 0 0-6 3 3 0 0 0 0 6m2-3a2 2 0 1 1-4 0 2 2 0 0 1 4 0m4 8c0 1-1 1-1 1H3s-1 0-1-1 1-4 6-4 6 3 6 4m-1-.004c-.001-.246-.154-.986-.832-1.664C11.516 10.68 10.289 10 8 10s-3.516.68-4.168 1.332c-.678.678-.83 1.418-.832 1.664z"/>
              </svg>
            </span>
            <input type="text" id="admin-user" name="admin[user]" class="form-ghost"
                   placeholder="Ex: 1984201" value="<%= params.dig(:admin, :user) %>">
          </div>
        </div>

        <div class="mb-6">
          <div class="d-flex justify-content-between">
            <label for="admin-pass" class="form-label fw-medium">Senha de Acesso</label>
            <span class="fs-xs fg-4">Obrigatório</span>
          </div>
          <div class="form-control form-adorn">
            <span class="form-adorn-icon">
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16">
                <path d="M8 1a2 2 0 0 1 2 2v4H6V3a2 2 0 0 1 2-2m3 6V3a3 3 0 0 0-6 0v4a2 2 0 0 0-2 2v5a2 2 0 0 0 2 2h6a2 2 0 0 0 2-2V9a2 2 0 0 0-2-2M5 8h6a1 1 0 0 1 1 1v5a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V9a1 1 0 0 1 1-1"/>
              </svg>
            </span>
            <input type="password" id="admin-pass" name="admin[password]" class="form-ghost"
                   placeholder="Digite sua senha de administrador">
          </div>
        </div>

        <button type="submit" class="btn-solid theme-primary w-100">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16">
            <path fill-rule="evenodd" d="M6 3.5a.5.5 0 0 1 .5-.5h8a.5.5 0 0 1 .5.5v9a.5.5 0 0 1-.5.5h-8a.5.5 0 0 1-.5-.5v-2a.5.5 0 0 0-1 0v2A1.5 1.5 0 0 0 6.5 14h8a1.5 1.5 0 0 0 1.5-1.5v-9A1.5 1.5 0 0 0 14.5 2h-8A1.5 1.5 0 0 0 5 3.5v2a.5.5 0 0 0 1 0z"/>
            <path fill-rule="evenodd" d="M11.854 8.354a.5.5 0 0 0 0-.708l-3-3a.5.5 0 1 0-.708.708L10.293 7.5H1.5a.5.5 0 0 0 0 1h8.793l-2.147 2.146a.5.5 0 0 0 .708.708z"/>
          </svg>
          Entrar no Sistema
        </button>
      <% end %>
    </div>
  </div>
</div>