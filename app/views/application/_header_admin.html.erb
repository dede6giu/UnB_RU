<% nav_active = 'nav-link active bg-primary fg-white' %>
<% nav_inactive = 'nav-link' %>
<% current_uri = request.env['PATH_INFO'] %>
<% path_gestao = '/home/index' %>
<% path_about = '/home/about' %>
<% nav_class_index = (current_uri == path_gestao or current_uri == '/') ? nav_active : nav_inactive %>
<% nav_class_about = (current_uri == path_about) ? nav_active : nav_inactive %>

<div id="header">
  <div class="d-flex gap-3 p-5 bg-white">
    <%= image_tag("placeholder.png", width: 120, height: 60, alt: "Admin logo") %>
    <div class="vr"></div>
    <div class="d-flex align-items-center flex-grow-1 fw-medium fg-primary">ADMINISTRAÇÃO GERAL</div>
    <div class="d-flex align-items-center gap-6">
      <div class="d-flex flex-column">
        <div class="d-flex justify-content-end fs-md">FULANO CICRANO DA SILVA</div><br>
        <div class="d-flex justify-content-end fs-xs">1754980</div>
      </div>
      <span class="avatar">
        <%= image_tag("placeholder.png", alt: "Admin logo", class: "avatar-img") %>
      </span>
      <%= button_tag "SAIR", class: "d-flex theme-danger btn-text" %>
    </div>
  </div>
  <ul class="nav p-3 bg-3 gap-5">
    <li class="nav-item">
      <%= link_to 'Gestão de Restaurantes', path_gestao, class: nav_class_index %>
    </li>
    <li class="nav-item">
      <%= link_to 'About', path_about, class: nav_class_about %>
    </li>
  </ul>
</div>