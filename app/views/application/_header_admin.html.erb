<% nav_active = 'nav-link active bg-primary fg-white' %>
<% nav_inactive = 'nav-link' %>
<% current_uri = request.env['PATH_INFO'] %>
<% path_home = /\A\/admin\/?\z/ %>
<% path_gestao = /\/admin\/(restaurant|turnstile)/ %>
<% path_shifts = '/admin/shifts' %>
<% path_about = '/home/about' %>
<% nav_class_index = (current_uri =~ path_gestao or current_uri =~ path_home) ? nav_active : nav_inactive %>
<% nav_class_shifts = (current_uri == path_shifts) ? nav_active : nav_inactive %>
<% nav_class_about = (current_uri == path_about) ? nav_active : nav_inactive %>

<div id="header">
  <div class="d-flex flex-wrap align-items-center gap-6 px-6 py-3 bg-white border-bottom">
    <div class="flex-grow-1">
      <%= render "brand", selo: "ADMINISTRAÇÃO", subtitulo: "Painel do Administrador" %>
    </div>

    <% if current_admin %>
      <div class="text-end">
        <div class="fs-sm fw-medium"><%= current_admin.name %></div>
        <div class="fs-xs fg-3">Admin · <%= current_admin.user %></div>
      </div>
      <%= button_to "Sair", admin_session_path, method: :delete, class: "btn-text theme-danger" %>
    <% end %>
  </div>
  <ul class="nav p-3 bg-3 gap-5">
    <li class="nav-item">
      <%= link_to 'Gestão de Restaurantes', restaurants_path, class: nav_class_index %>
    </li>
    <li class="nav-item">
      <%= link_to 'Turnos e Time-frames', admin_shifts_path, class: nav_class_shifts %>
    </li>
    <li class="nav-item">
      <%= link_to 'About', '/', class: nav_class_about %>
    </li>
  </ul>
</div>
