<div class="d-flex align-items-center gap-6 px-6 py-3 bg-white border-bottom">
  <div class="flex-grow-1">
    <%= link_to root_path, class: "d-inline-flex align-items-center gap-3 text-decoration-none" do %>
      <div class="bg-primary fg-white rounded-3 p-2 fw-bold">UnB</div>
      <div>
        <div class="fw-bold fg-primary fs-lg lh-1">RU UnB Digital</div>
        <div class="fs-xs fg-3 text-uppercase">Portal do Estudante</div>
      </div>
    <% end %>
  </div>

  <% if current_student %>
    <%= button_to "Sair", student_session_path, method: :delete, class: "btn-text theme-danger" %>
  <% end %>
</div>
