<% nav_active = "nav-link active bg-primary fg-white" %>
<% nav_inactive = "nav-link" %>
<% no_inicio = current_page?(root_path) %>
<% no_cardapio = current_page?(public_menu_path) %>

<header class="d-flex align-items-center gap-3 p-3 bg-white">
  <%= image_tag "placeholder.png", width: 120, height: 60, class: "img-fluid", alt: "Restaurante Universitário" %>
  <span class="vr" aria-hidden="true"></span>
  <span class="d-flex align-items-center flex-grow-1 fw-medium fg-primary">RESTAURANTE UNIVERSITÁRIO</span>
</header>

<nav class="nav p-3 bg-3 gap-3" aria-label="Navegação principal">
  <%= link_to "Início", root_path, class: no_inicio ? nav_active : nav_inactive, aria: { current: ("page" if no_inicio) } %>
  <%= link_to "Cardápio", public_menu_path, class: no_cardapio ? nav_active : nav_inactive, aria: { current: ("page" if no_cardapio) } %>
</nav>
