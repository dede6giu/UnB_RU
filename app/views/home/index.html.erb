<% class_box = "d-flex bg-white p-5 flex-grow-1 shadow-sm" %>

<div class="p-12 bg-1">
  <!-- CABEÇALHO -->
  <div class="d-flex p-2 gap-3">
    <p class="fg-primary fw-medium h1 flex-grow-1">
      Gestão de Restaurantes e Catracas
    </p>
    <%= button_tag "Cadastrar Restaurante", class: "btn-outline theme-primary" %>
  </div>
  <!-- DATA GERAL -->
  <div class="d-flex p-2 gap-6 mt-6">
    <div class="<%= class_box %>">
      <div class="d-flex flex-grow-1 flex-column">
        <div class="fs-sm fg-4">TOTAL DE RESTAURANTES</div>
        <div class="fs-2xl fg-success fw-medium">1 Unidade</div>
      </div>
      <%= image_tag "placeholder.png", width: 80, height: 80 %>
    </div>
    <div class="<%= class_box %>">
      <div class="d-flex flex-grow-1 flex-column">
        <div class="fs-sm fg-4">TOTAL DE RESTAURANTES</div>
        <div class="fs-2xl fg-success fw-medium">1 Unidade</div>
      </div>
      <%= image_tag "placeholder.png", width: 80, height: 80 %>
    </div>
    <div class="<%= class_box %>">
      <div class="d-flex flex-grow-1 flex-column">
        <div class="fs-sm fg-4">TOTAL DE RESTAURANTES</div>
        <div class="fs-2xl fg-success fw-medium">1 Unidade</div>
      </div>
      <%= image_tag "placeholder.png", width: 80, height: 80 %>
    </div>
  </div>

  <!-- CABEÇALHO RESTAURANTES -->
  <div class="mt-6 p-2 h2">Unidades Cadastradas</div>
  <!-- RESTAURANTES -->
  <div>
    <!-- RESTAURANTE 1 -->
    <div class="mt-5 bg-white shadow-sm">
      <!-- NOME -->
      <div class="d-flex p-5 gap-5 bg-3">
        <div class="bg-success fg-white ms-4 w-4 fs-3xl text-center fw-semibold rounded-3">1</div>
        <div class="d-flex flex-grow-1 flex-column">
          <div class="h3 fg-success fw-semibold">Nome (Campus)</div>
          <div class="fs-sm fg-4 fw-normal">Catracas: qtd</div>
        </div>
        <%= button_tag "Editar Unidade", class: "btn-outline theme-success" %>
        <%= button_tag "Cadastrar Catraca", class: "btn-outline theme-success" %>
      </div>
      <!-- CATRACAS -->
      <div class="p-4">
        <div class="container-fluid">
          <div class="row row-cols-2 g-3">
            <!-- ESTILO ATIVA -->
            <div class="col d-flex">
              <div class="flex-column bg-2 p-5 flex-grow-1">
                <div class="fw-bold fs-md">Catraca Nome 1</div>
                <div class="d-flex gap-3 align-items-center">
                  <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-circle fg-success" viewBox="0 0 16 16">
                    <path d="M8 15A7 7 0 1 1 8 1a7 7 0 0 1 0 14m0 1A8 8 0 1 0 8 0a8 8 0 0 0 0 16"/>
                  </svg>
                  <div class="fs-md fg-success">Ativa</div>
                </div>
              </div>
              <div class="bg-2 align-content-center p-5">
                <%= button_tag "Editar catraca", class: "btn-outline theme-primary" %>
              </div>
            </div>
            <!-- ESTILO INATIVA -->
            <div class="col d-flex">
              <div class="flex-column bg-2 p-5 flex-grow-1">
                <div class="fw-bold fs-md">Catraca Nome 2</div>
                <div class="d-flex gap-3 align-items-center">
                  <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-circle-fill fg-danger" viewBox="0 0 16 16">
                    <circle cx="8" cy="8" r="8"/>
                  </svg>
                  <div class="fs-md fg-danger">Inativa</div>
                </div>
              </div>
              <div class="bg-2 align-content-center p-5">
                <%= button_tag "Editar catraca", class: "btn-outline theme-primary" %>
              </div>
            </div>
            <!-- ESTILO OPERANDO -->
            <div class="col d-flex">
              <div class="flex-column bg-2 p-5 flex-grow-1">
                <div class="fw-bold fs-md">Catraca Nome 3</div>
                <div class="d-flex gap-3 align-items-center">
                  <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-circle-fill fg-success" viewBox="0 0 16 16">
                    <circle cx="8" cy="8" r="8"/>
                  </svg>
                  <div class="fs-md fg-success">Operando</div>
                </div>
              </div>
              <div class="bg-2 align-content-center p-5">
                <%= button_tag "Editar catraca", class: "btn-outline theme-primary" %>
              </div>
            </div>

            <!-- ESTILO FASTPASS -->
            <div class="col d-flex">
              <div class="flex-column bg-2 p-5 flex-grow-1">
                <div class="fw-bold fs-md">Catraca Nome 4</div>
                <div class="d-flex gap-3 align-items-center">
                  <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-circle-fill fg-accent" viewBox="0 0 16 16">
                    <circle cx="8" cy="8" r="8"/>
                  </svg>
                  <div class="fs-md fg-accent">FastPass</div>
                </div>
              </div>
              <div class="bg-2 align-content-center p-5">
                <%= button_tag "Editar catraca", class: "btn-outline theme-primary" %>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- RESTAURANTE 2 -->
    <div class="mt-5 bg-white shadow-sm">
      <!-- NOME -->
      <div class="d-flex p-5 gap-5 bg-3">
        <div class="bg-success fg-white ms-4 w-4 fs-3xl text-center fw-semibold rounded-3">2</div>
        <div class="d-flex flex-grow-1 flex-column">
          <div class="h3 fg-success fw-semibold">Nome (Campus)</div>
          <div class="fs-sm fg-4 fw-normal">Catracas: qtd</div>
        </div>
        <%= button_tag "Editar Unidade", class: "btn-outline theme-success" %>
        <%= button_tag "Cadastrar Catraca", class: "btn-outline theme-success" %>
      </div>
      <!-- CATRACAS -->
      <div class="p-4">
        <div class="container-fluid">
          <div class="row row-cols-2 g-3">
            <!-- ESTILO ATIVA -->
            <div class="col d-flex">
              <div class="flex-column bg-2 p-5 flex-grow-1">
                <div class="fw-bold fs-md">Catraca Nome 1</div>
                <div class="d-flex gap-3 align-items-center">
                  <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-circle fg-success" viewBox="0 0 16 16">
                    <path d="M8 15A7 7 0 1 1 8 1a7 7 0 0 1 0 14m0 1A8 8 0 1 0 8 0a8 8 0 0 0 0 16"/>
                  </svg>
                  <div class="fs-md fg-success">Ativa</div>
                </div>
              </div>
              <div class="bg-2 align-content-center p-5">
                <%= button_tag "Editar catraca", class: "btn-outline theme-primary" %>
              </div>
            </div>
            <!-- ESTILO INATIVA -->
            <div class="col d-flex">
              <div class="flex-column bg-2 p-5 flex-grow-1">
                <div class="fw-bold fs-md">Catraca Nome 2</div>
                <div class="d-flex gap-3 align-items-center">
                  <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-circle-fill fg-danger" viewBox="0 0 16 16">
                    <circle cx="8" cy="8" r="8"/>
                  </svg>
                  <div class="fs-md fg-danger">Inativa</div>
                </div>
              </div>
              <div class="bg-2 align-content-center p-5">
                <%= button_tag "Editar catraca", class: "btn-outline theme-primary" %>
              </div>
            </div>
            <!-- ESTILO FASTPASS -->
            <div class="col d-flex">
              <div class="flex-column bg-2 p-5 flex-grow-1">
                <div class="fw-bold fs-md">Catraca Nome 3</div>
                <div class="d-flex gap-3 align-items-center">
                  <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-circle-fill fg-accent" viewBox="0 0 16 16">
                    <circle cx="8" cy="8" r="8"/>
                  </svg>
                  <div class="fs-md fg-accent">FastPass</div>
                </div>
              </div>
              <div class="bg-2 align-content-center p-5">
                <%= button_tag "Editar catraca", class: "btn-outline theme-primary" %>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>