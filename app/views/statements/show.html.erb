<% content_for :title, "Extrato e Histórico de Refeições" %>
<div data-bs-theme="light" class="bg-1 min-vh-100">
  <%= render "header_estudante" %>
  <%= render "nav_estudante" %>

  <div class="mx-auto mt-8" style="max-width: 960px;">
    <%= render "flash" %>

    <div class="d-flex justify-content-between align-items-center mb-4">
      <h1 class="h3 fw-semibold fg-primary mb-0">Extrato e Histórico de Refeições</h1>
      <%= link_to "Exportar PDF", statement_path(format: :pdf, period: params[:period], type: params[:type]),
                  class: "btn-outline theme-secondary" %>
    </div>

    <div class="card shadow-sm mb-6">
      <div class="card-body p-6">
        <%= form_with url: statement_path, method: :get, class: "d-flex align-items-end gap-4" do |form| %>
          <div>
            <%= form.label :period, "Período de referência", class: "form-label fw-medium" %>
            <%= form.select :period, StatementsHelper::PERIOD_OPTIONS, { selected: params[:period] }, class: "form-control" %>
          </div>
          <div>
            <%= form.label :type, "Tipo de lançamento", class: "form-label fw-medium" %>
            <%= form.select :type, StatementsHelper::TYPE_OPTIONS, { selected: params[:type] }, class: "form-control" %>
          </div>
          <%= form.submit "Filtrar", name: nil, class: "btn-solid theme-primary" %>
          <%= link_to "Limpar filtros", statement_path, class: "fs-sm" %>
        <% end %>
      </div>
    </div>

    <div class="row g-4 mb-6">
      <div class="md:col-4">
        <div class="card shadow-sm h-100">
          <div class="card-body p-6">
            <div class="fs-xs fg-3 text-uppercase">Total gasto</div>
            <div class="fs-xl fw-bold"><%= reais(@spent_cents) %></div>
          </div>
        </div>
      </div>
      <div class="md:col-4">
        <div class="card shadow-sm h-100">
          <div class="card-body p-6">
            <div class="fs-xs fg-3 text-uppercase">Refeições realizadas</div>
            <div class="fs-xl fw-bold"><%= pluralize(@meals_count, "refeição", "refeições") %></div>
          </div>
        </div>
      </div>
      <div class="md:col-4">
        <div class="card shadow-sm h-100">
          <div class="card-body p-6">
            <div class="fs-xs fg-3 text-uppercase">Total recarregado</div>
            <div class="fs-xl fw-bold fg-success"><%= reais(@recharged_cents) %></div>
            <div class="fs-xs fg-3">Saldo restante: <%= reais(@student.balance_cents) %></div>
          </div>
        </div>
      </div>
    </div>

    <div class="card shadow-sm">
      <div class="card-body p-0">
        <% if @student.transactions.empty? %>
          <p class="p-6 mb-0 fg-3">Você ainda não tem lançamentos.</p>
        <% elsif @transactions.empty? %>
          <p class="p-6 mb-0 fg-3">Nenhum lançamento com esses filtros.</p>
        <% else %>
          <table class="table mb-0">
            <thead>
              <tr>
                <th>Data e hora</th>
                <th>Lançamento</th>
                <th>Meio</th>
                <th class="text-end">Valor</th>
              </tr>
            </thead>
            <tbody>
              <% @page_transactions.each do |transaction| %>
                <tr>
                  <td><%= entry_time(transaction) %></td>
                  <td><%= entry_label(transaction) %></td>
                  <td><%= payment_label(transaction) %></td>
                  <td class="text-end fw-semibold"><%= signed_amount(transaction) %></td>
                </tr>
              <% end %>
            </tbody>
          </table>

          <% if @total_pages > 1 %>
            <div class="d-flex justify-content-between align-items-center p-4 fs-sm">
              <span>Página <%= @page %> de <%= @total_pages %></span>
              <div class="d-flex gap-4">
                <% if @page > 1 %>
                  <%= link_to "Anterior", statement_path(page: @page - 1, period: params[:period], type: params[:type]) %>
                <% end %>
                <% if @page < @total_pages %>
                  <%= link_to "Próxima", statement_path(page: @page + 1, period: params[:period], type: params[:type]) %>
                <% end %>
              </div>
            </div>
          <% end %>
        <% end %>
      </div>
    </div>
  </div>
</div>
