<% content_for :title, "Extrato e Histórico de Refeições" %>
<div data-bs-theme="light" class="bg-1 min-vh-100">
  <%= render "header_estudante" %>
  <%= render "nav_estudante" %>

  <div class="mx-auto mt-8" style="max-width: 960px;">
    <%= render "flash" %>

    <h1 class="h3 fw-semibold fg-primary mb-4">Extrato e Histórico de Refeições</h1>

    <div class="row g-4 mb-6">
      <div class="md:col-4">
        <div class="card shadow-sm h-100">
          <div class="card-body p-6">
            <div class="fs-xs fg-3 text-uppercase">Total gasto</div>
            <div class="fs-xl fw-bold"><%= reais(@spent_cents) %></div>
          </div>
        </div>
      </div>
      <div class="md:col-4">
        <div class="card shadow-sm h-100">
          <div class="card-body p-6">
            <div class="fs-xs fg-3 text-uppercase">Refeições realizadas</div>
            <div class="fs-xl fw-bold"><%= pluralize(@meals_count, "refeição", "refeições") %></div>
          </div>
        </div>
      </div>
      <div class="md:col-4">
        <div class="card shadow-sm h-100">
          <div class="card-body p-6">
            <div class="fs-xs fg-3 text-uppercase">Total recarregado</div>
            <div class="fs-xl fw-bold fg-success"><%= reais(@recharged_cents) %></div>
            <div class="fs-xs fg-3">Saldo restante: <%= reais(@student.balance_cents) %></div>
          </div>
        </div>
      </div>
    </div>

    <div class="card shadow-sm">
      <div class="card-body p-0">
        <% if @transactions.empty? %>
          <p class="p-6 mb-0 fg-3">Você ainda não tem lançamentos.</p>
        <% else %>
          <table class="table mb-0">
            <thead>
              <tr>
                <th>Data e hora</th>
                <th>Lançamento</th>
                <th>Meio</th>
                <th class="text-end">Valor</th>
              </tr>
            </thead>
            <tbody>
              <% @transactions.each do |transaction| %>
                <tr>
                  <td><%= entry_time(transaction) %></td>
                  <td><%= entry_label(transaction) %></td>
                  <td><%= payment_label(transaction) %></td>
                  <td class="text-end fw-semibold"><%= signed_amount(transaction) %></td>
                </tr>
              <% end %>
            </tbody>
          </table>
        <% end %>
      </div>
    </div>
  </div>
</div>
